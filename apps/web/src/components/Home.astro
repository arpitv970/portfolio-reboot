---
import TestComponent from "./TestComponent.astro";
import { getCollection } from "astro:content";

const blogs = await getCollection("blog");
---
<section>
  <h1>This is Home page built using <a href="https://astro.build" target="_blank">Astro</a></h1>
  <p>We are here trying out various file-supports in this framework, which goes as follows:</p>
  <ul>
    <li><a href="/">.astro</a></li>
    <li><a href="/md">.md</a></li>
  </ul>
</section>
<section>
  <h1>This is for dynamic routing</h1>
  <p>Here is for SSG mode</p>
  <ul>
    <li><a href="/dogs">SSG</a></li>
    <li><a href="/dogs-ssr">SSR</a></li>
  </ul>
</section>
<section>
  <TestComponent greet={"Hey"} name={"Arpit"}>
    <div slot="top">Slot top</div>
    <div>Slot default</div>
    <div slot="bottom">Slot bottom</div>
  </TestComponent>
</section>
<section>
  <h1>My Blogs</h1>
  <ul>
    {blogs.map(b => (
    <li><a href={`/blog/${b.id}`}>{b.data.title}</a></li>
    ))}
  </ul>
</section>
